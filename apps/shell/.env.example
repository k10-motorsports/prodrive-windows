# RaceCor Pro Drive Windows Shell Environment Variables

# Override the web app URL (default: https://prodrive.racecor.io)
RACECOR_URL=https://prodrive.racecor.io

# Development mode (enables DevTools, skips auto-updater)
NODE_ENV=development

# Code signing (Windows EV certificate for production builds)
# CSC_LINK=/path/to/certificate.pfx
# CSC_KEY_PASSWORD=certificate-password

# For MSIX builds specifically
# WIN_CSC_LINK=/path/to/certificate.pfx
# WIN_CSC_KEY_PASSWORD=certificate-password
