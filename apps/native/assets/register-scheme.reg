Windows Registry Editor Version 5.00

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\FileExts\.racecor-prodrive\UserChoice]

[HKEY_CURRENT_USER\Software\Classes\racecor-prodrive]
@="URL:RaceCor Pro Drive"
"URL Protocol"=""

[HKEY_CURRENT_USER\Software\Classes\racecor-prodrive\shell]

[HKEY_CURRENT_USER\Software\Classes\racecor-prodrive\shell\open]

[HKEY_CURRENT_USER\Software\Classes\racecor-prodrive\shell\open\command]
@="\"C:\\Users\\<USERNAME>\\AppData\\Local\\RaceCorProDrive\\RaceCorProDrive.exe\" \"%%1\""
