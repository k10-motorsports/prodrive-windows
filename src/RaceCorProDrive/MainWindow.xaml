<Window
    x:Class="RaceCorProDrive.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RaceCorProDrive">

    <Grid Background="{ThemeResource ApplicationBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid x:Name="AppTitleBar" Height="40" Background="Transparent" VerticalAlignment="Top">
            <TextBlock x:Name="AppTitle" Text="RaceCor Pro Drive" Margin="12,8,0,0"
                       VerticalAlignment="Top"
                       Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                       FontSize="14" FontWeight="SemiBold" />
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,12,0" Orientation="Horizontal" Spacing="8">
                <TextBlock x:Name="UserDisplay" Text="User"
                           Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                           VerticalAlignment="Center" FontSize="12" />
                <Button x:Name="SignOutButton" Content="Sign Out" Click="OnSignOut" />
            </StackPanel>
        </Grid>

        <!-- Authed shell: nav + page frame. Visibility flipped by code-behind. -->
        <NavigationView x:Name="NavView" Grid.Row="1"
                        Visibility="Collapsed"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsPaneOpen="True"
                        Loaded="OnNavViewLoaded">
            <NavigationView.MenuItems>
                <NavigationViewItem Icon="Home" Content="Dashboard" x:Name="NavDashboard" Tag="dashboard" />
                <NavigationViewItem Icon="List" Content="Races" x:Name="NavRaces" Tag="races" />
                <NavigationViewItem Icon="Library" Content="Library" x:Name="NavLibrary" Tag="library" />
                <NavigationViewItemSeparator />
                <NavigationViewItem Icon="ShowResults" Content="Moments" x:Name="NavMoments" Tag="moments" />
                <NavigationViewItem Icon="MapPin" Content="Tracks" x:Name="NavTracks" Tag="tracks" />
                <NavigationViewItem Icon="Bookmarks" Content="Cars" x:Name="NavCars" Tag="cars" />
                <NavigationViewItemSeparator />
                <NavigationViewItem Icon="World" Content="DNA" x:Name="NavDNA" Tag="dna" />
                <NavigationViewItem Icon="Clock" Content="When" x:Name="NavWhen" Tag="when" />
                <NavigationViewItem Icon="ProtectedDocument" Content="Safety" x:Name="NavSafety" Tag="safety" />
                <NavigationViewItem Icon="Favorite" Content="Composure" x:Name="NavComposure" Tag="composure" />
                <NavigationViewItemSeparator />
                <NavigationViewItem Icon="Document" Content="Debrief" x:Name="NavDebrief" Tag="debrief" />
                <NavigationViewItem Icon="Setting" Content="Settings" x:Name="NavSettings" Tag="settings" />
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <!-- Pre-auth: LoginPage rendered full-window so its own centering works. -->
        <Frame x:Name="AuthFrame" Grid.Row="1" Loaded="OnAuthFrameLoaded" />
    </Grid>
</Window>
