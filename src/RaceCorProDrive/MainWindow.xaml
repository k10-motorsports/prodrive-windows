<Window
    x:Class="RaceCorProDrive.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RaceCorProDrive">

    <!--
        RequestedTheme=Dark forces all WinUI default brushes
        (DropDownButton chevrons, MenuFlyout backgrounds, ProgressRing,
        etc.) to resolve in dark mode regardless of the user's system
        theme. Without this, the dashboard's filter dropdowns render
        black chevrons on dark glass on light-system-theme machines.

        Layout uses z-order, NOT rows: the active page Frame fills the
        whole window so its livery photo + content extend to y=0.
        AppTitleBar floats on top as a transparent 32pt drag region
        that hosts the system caption buttons (min/max/close) — the
        only "title bar" Windows lets us keep, and even those float
        directly over the page content with no visible chrome.
    -->
    <Grid Background="{ThemeResource ApplicationBackgroundThemeBrush}"
          RequestedTheme="Dark">

        <!-- Authed shell: a Frame holding the active page. Pages own
             their own primary nav (LeftRail) and just need to keep
             their top-right ~140×32pt corner free of interactive
             controls so the system caption buttons aren't obscured. -->
        <Frame x:Name="ContentFrame" Visibility="Collapsed" Loaded="OnContentFrameLoaded" />

        <!-- Pre-auth: LoginPage rendered full-window. -->
        <Frame x:Name="AuthFrame" Loaded="OnAuthFrameLoaded" />

        <!-- Invisible drag region floating on top of the page's top
             32pt. SetTitleBar() in the code-behind hands this to the
             system as the "title bar" — clicks on blank areas drag
             the window, clicks on interactive children pass through. -->
        <Grid x:Name="AppTitleBar" Height="32" Background="Transparent" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>
        </Grid>
    </Grid>
</Window>
