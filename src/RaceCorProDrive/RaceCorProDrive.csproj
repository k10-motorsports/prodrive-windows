<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <WindowsSdkPackageVersion>10.0.19041.57</WindowsSdkPackageVersion>
    <UseWinUI>true</UseWinUI>
    <UseXamlCompilerExecutable>false</UseXamlCompilerExecutable>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableMsixTooling>true</EnableMsixTooling>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
    <GenerateTestArtifacts>false</GenerateTestArtifacts>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$(Platform)</RuntimeIdentifier>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyName>RaceCorProDrive</AssemblyName>
    <RootNamespace>RaceCorProDrive</RootNamespace>
    <Version>0.1.0</Version>
    <Company>K10 Motorsports</Company>
    <Product>RaceCor Pro Drive</Product>
    <Copyright>Copyright (c) 2026 K10 Motorsports / Kevin Conboy. All rights reserved.</Copyright>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.5.241114000" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.0" />
    <!--
      mDNS/Bonjour service discovery for the LAN bundle-share feature.
      Zeroconf bundles a managed mDNS implementation, so the user does
      NOT need Apple's Bonjour service installed. One-shot resolution
      via ZeroconfResolver.ResolveAsync(...) is enough for the "click
      Send → pick a Mac" UX; we don't need a continuous browser.
    -->
    <PackageReference Include="Zeroconf" Version="3.6.11" />
    <!--
      Moza serial protocol talks straight to CDC ACM ports. .NET 8
      moved both of these out of the BCL into NuGet packages —
      System.IO.Ports for SerialPort, System.Management for the WMI
      Win32_PnPEntity query that surfaces USB descriptions + VID/PID.
    -->
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!--
      Lucide-matching nav icons. Kept as a glob so new icons added
      later under Assets/LucideIcons/ flow through without touching
      the csproj. `ms-appx:///Assets/LucideIcons/<kind>.svg` is the
      URI `LucideIcon` resolves at runtime.
    -->
    <Content Include="Assets\LucideIcons\*.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
