<Application
    x:Class="RaceCorProDrive.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RaceCorProDrive">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <local:DesignSystem />
            </ResourceDictionary.MergedDictionaries>

            <!-- Theme: Dark (v1 default) -->
            <Color x:Key="ApplicationForeground">#FFFFFF</Color>
            <Color x:Key="ApplicationBackground">#0A0A14</Color>
            <SolidColorBrush x:Key="ApplicationForegroundThemeBrush" Color="{StaticResource ApplicationForeground}" />
            <SolidColorBrush x:Key="ApplicationBackgroundThemeBrush" Color="{StaticResource ApplicationBackground}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
