<Page
    x:Class="RaceCorProDrive.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:design="using:RaceCorProDrive.DesignSystem"
    xmlns:components="using:RaceCorProDrive.DesignSystem.Components"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">

    <!-- DIAGNOSTIC: stripped to find which custom control crashes the page.
         All x:Name elements the codebehind references are kept as no-op
         placeholders so build still passes. Add real layout back once
         the bad control is identified. -->
    <Grid Background="#FF0A0A14">
        <design:ThemedBackgroundControl />

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header row holds elements codebehind references by x:Name -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Padding="20,8">
            <components:DashboardTabs x:Name="TabsBar" SelectionChanged="OnTabChanged" />
            <DropDownButton x:Name="ContextFilterButton" Content="Context" />
            <DropDownButton x:Name="LicenseFilterButton" Content="License" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Padding="20,0">
            <StackPanel x:Name="MainContent" Orientation="Vertical" Spacing="14">
                <TextBlock Text="Dashboard scaffold loaded — content will fill in once we find the crashing control."
                           Foreground="White" FontSize="14"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </ScrollViewer>

        <!-- DataStrip pinned to bottom; comment out if it's the culprit -->
        <components:DataStrip x:Name="StatStrip" Grid.Row="2" />

        <ProgressRing x:Name="LoadingRing"
                      IsActive="False"
                      Width="48" Height="48"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
    </Grid>
</Page>
