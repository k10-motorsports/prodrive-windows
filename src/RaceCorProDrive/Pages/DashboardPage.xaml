<Page
    x:Class="RaceCorProDrive.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:design="using:RaceCorProDrive.DesignSystem"
    xmlns:components="using:RaceCorProDrive.DesignSystem.Components"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">

    <!--
        Background, LeftRail, dashboard tabs, and filter buttons all
        live in MainWindow chrome now. Tabs sit in the titlebar slot
        next to the K10 logomark; filters sit immediately left of the
        system caption buttons. This page just owns the body content
        + sidebar + footer, offset 72pt to clear the floating rail.
    -->

    <!-- Background + LeftRail + page tabs + filters all live in
         MainWindow chrome now. Tabs/filters are pushed into the
         titlebar slots from OnLoaded so they sit in the same strip
         as the system caption buttons. The page itself just owns
         the content + footer + spinner, offset 72pt to clear the
         floating rail. -->
    <Grid>
        <Grid Margin="72,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Main column -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <!-- Spacer for the 44pt titlebar (tabs + filters
                         live up there, in MainWindow chrome). -->
                    <RowDefinition Height="44" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Hairline under the titlebar tabs. -->
                <Border Grid.Row="1"
                        Height="1"
                        Background="{StaticResource BorderSubtleBrush}" />

                <ScrollViewer Grid.Row="2"
                              Padding="20,14,20,12">
                    <StackPanel x:Name="MainContent"
                                Orientation="Vertical"
                                Spacing="14" />
                </ScrollViewer>

                <components:DataStrip x:Name="StatStrip"
                                      Grid.Row="3" />
            </Grid>

            <components:SidebarTabs x:Name="Sidebar"
                                    Grid.Column="1" />
        </Grid>

        <ProgressRing x:Name="LoadingRing"
                      IsActive="False"
                      Width="48" Height="48"
                      Foreground="{StaticResource BrandRedBrush}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
    </Grid>
</Page>
