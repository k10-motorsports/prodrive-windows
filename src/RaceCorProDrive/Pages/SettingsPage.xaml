<Page
    x:Class="RaceCorProDrive.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:design="using:RaceCorProDrive.DesignSystem"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">
    <!--
        Settings UI for the in-game HUD. Backed by
        OverlaySettingsService. Architecture:

          ┌─ NavigationView (left) ─┬─ Page header with status ─┐
          │  Visual                 │  ScrollViewer:            │
          │  Commentary             │   - SettingsCard 1        │
          │  Recording              │   - SettingsCard 2        │
          │  System                 │   - SettingsCard 3        │
          │  Hardware (PR-3)        │   - ...                   │
          └─────────────────────────┴───────────────────────────┘

        Race Rules removed (incident counts come from iRacing telemetry,
        force flag was dev-only, drive/rally modes never wired up). HUD
        launch + Hotkeys merged into System. Commentary + Coach merged
        into Commentary.

        Visual is currently a stub mirroring the legacy flat toggles -
        PR-B replaces it with a drag/drop module-group editor that
        targets the overlay's 6 anchor zones (TL/TC/TR/BL/BC/BR).
    -->

    <Grid RequestedTheme="Dark">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <design:ThemedBackgroundControl />

        <!-- Category nav. Pinned to a 220pt left rail so the right
             pane has predictable width. -->
        <NavigationView
            x:Name="CategoryNav"
            Grid.Column="0"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneToggleButtonVisible="False"
            PaneDisplayMode="Left"
            OpenPaneLength="220"
            IsPaneOpen="True"
            SelectionChanged="OnCategoryChanged"
            Background="Transparent">

            <NavigationView.MenuItems>
                <NavigationViewItem Tag="visual"     Content="Visual" />
                <NavigationViewItem Tag="commentary" Content="Commentary" />
                <NavigationViewItem Tag="recording"  Content="Recording" />
                <NavigationViewItem Tag="system"     Content="System" />
            </NavigationView.MenuItems>
        </NavigationView>

        <!-- Right pane: header (title + caption + save status) +
             scrollable card list. -->
        <Grid Grid.Column="1" Padding="40,32,40,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="4">
                    <TextBlock x:Name="PageTitleText"
                               FontSize="11"
                               FontWeight="Bold"
                               CharacterSpacing="200"
                               Foreground="{StaticResource BrandRedBrush}"
                               Text="SETTINGS" />
                    <TextBlock x:Name="PageHeadingText"
                               FontSize="28"
                               FontWeight="Black"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Text="Visual" />
                    <TextBlock x:Name="PageCaptionText"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               MaxWidth="640" />
                </StackPanel>
                <TextBlock x:Name="SaveStatusText"
                           Grid.Column="1"
                           VerticalAlignment="Bottom"
                           FontSize="11"
                           FontFamily="Consolas"
                           Foreground="{StaticResource TextDimBrush}"
                           Text="" />
            </Grid>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="CardsHost"
                            Orientation="Vertical"
                            Spacing="14"
                            MaxWidth="780"
                            HorizontalAlignment="Left" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
