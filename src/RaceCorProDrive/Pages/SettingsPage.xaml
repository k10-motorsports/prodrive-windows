<Page
    x:Class="RaceCorProDrive.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:design="using:RaceCorProDrive.DesignSystem"
    xmlns:components="using:RaceCorProDrive.DesignSystem.Components"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">
    <!--
        Settings UI for the in-game HUD. Backed by
        OverlaySettingsService. Layout matches DashboardPage's chrome:
        LeftRail on the left, horizontal tab strip across the top of
        the content column (mirrors DashboardTabs visually), then a
        page header + scrollable card list below.

        The tab strip sits in a 76pt row with the tabs anchored to the
        BOTTOM 44pt — the top 32pt of that row belongs to the
        chromeless window's drag region (system caption buttons live
        there). Without this offset the tab clicks were getting eaten
        by the drag region (same fix the DashboardPage tabs row uses).

        Race Rules removed (incident counts come from iRacing telemetry,
        force flag was dev-only, drive/rally modes never wired up).
        HUD launch + Hotkeys merged into System. Commentary + Coach
        merged into Commentary.

        Visual is currently a stub mirroring the legacy flat toggles -
        PR-B replaces it with a drag/drop module-group editor that
        targets the overlay's 6 anchor zones (TL/TC/TR/BL/BC/BR).
    -->

    <!-- Background + LeftRail live in MainWindow chrome (one livery
         photo for the whole session, rail outside the navigated frame
         so page transitions don't slide it). This page just provides
         the content column, offset 72pt to clear the rail. -->
    <Grid RequestedTheme="Dark" Margin="72,0,0,0">
            <Grid.RowDefinitions>
                <!-- Top 32pt = drag region; tabs sit in the bottom 44pt. -->
                <RowDefinition Height="76" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Horizontal tabs row. -->
            <Border Grid.Row="0"
                    Padding="40,0,40,0"
                    Height="44"
                    VerticalAlignment="Bottom">
                <components:HorizontalTabs x:Name="CategoryTabs"
                                           SelectionChanged="OnCategoryTabChanged" />
            </Border>

            <!-- Hairline under the tabs. -->
            <Border Grid.Row="1"
                    Height="1"
                    Background="{StaticResource BorderSubtleBrush}" />

            <!-- Content pane: header (title + caption + save status) +
                 scrollable card list. -->
            <Grid Grid.Row="2" Padding="40,24,40,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="4">
                        <TextBlock x:Name="PageTitleText"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   CharacterSpacing="200"
                                   Foreground="{StaticResource BrandRedBrush}"
                                   Text="SETTINGS" />
                        <TextBlock x:Name="PageHeadingText"
                                   FontSize="28"
                                   FontWeight="Black"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="Visual" />
                        <TextBlock x:Name="PageCaptionText"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   MaxWidth="640" />
                    </StackPanel>
                    <TextBlock x:Name="SaveStatusText"
                               Grid.Column="1"
                               VerticalAlignment="Bottom"
                               FontSize="11"
                               FontFamily="Consolas"
                               Foreground="{StaticResource TextDimBrush}"
                               Text="" />
                </Grid>

                <!-- Two-column card layout. Each column is its own
                     StackPanel so cards flow vertically within their
                     column (column-major). Code-behind packs each card
                     into whichever column is currently shorter
                     (estimated from row count) so the two columns end
                     up roughly balanced in height. -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="CardsHost"
                          ColumnSpacing="14"
                          MaxWidth="1280"
                          HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="LeftColumn"
                                    Grid.Column="0"
                                    Orientation="Vertical"
                                    Spacing="14"
                                    VerticalAlignment="Top" />
                        <StackPanel x:Name="RightColumn"
                                    Grid.Column="1"
                                    Orientation="Vertical"
                                    Spacing="14"
                                    VerticalAlignment="Top" />
                    </Grid>
                </ScrollViewer>
            </Grid>
    </Grid>
</Page>
