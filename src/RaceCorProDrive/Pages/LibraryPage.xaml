<Page
    x:Class="RaceCorProDrive.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RaceCorProDrive.Pages"
    Background="{ThemeResource ApplicationBackgroundThemeBrush}"
    Loaded="OnLoaded">

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header strip -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="2">
                <TextBlock
                    Text="Library"
                    FontSize="24"
                    FontWeight="Bold"
                    Foreground="{ThemeResource ApplicationForegroundThemeBrush}" />
                <TextBlock
                    x:Name="CountText"
                    Text=""
                    FontSize="11"
                    Foreground="#8A8A95" />
            </StackPanel>

            <Button
                Grid.Column="1"
                x:Name="RefreshButton"
                Content="Refresh"
                Click="OnRefresh" />
        </Grid>

        <!-- Tile grid -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <ItemsRepeater
                    x:Name="LibraryRepeater"
                    HorizontalAlignment="Stretch">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            Orientation="Horizontal"
                            MinItemWidth="280"
                            MinItemHeight="240"
                            MinRowSpacing="16"
                            MinColumnSpacing="16" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="local:LibraryItemViewModel">
                            <Button
                                Click="OnTileClick"
                                Tag="{x:Bind Path}"
                                Padding="0"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Background="#14142a"
                                BorderBrush="#262638"
                                BorderThickness="1"
                                CornerRadius="12">
                                <Button.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem
                                            Text="Send to Mac…"
                                            Tag="{x:Bind Path}"
                                            Click="OnSendToMac">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE898;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem
                                            Text="Show in Explorer"
                                            Tag="{x:Bind Path}"
                                            Click="OnShowInExplorer">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE838;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.ContextFlyout>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="160" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Thumbnail placeholder. Real preview frame
                                         lands when we add MediaFoundation extract. -->
                                    <Grid>
                                        <Grid.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#0a0a14" Offset="0.0" />
                                                <GradientStop Color="#1a0e10" Offset="0.5" />
                                                <GradientStop Color="#0a0a14" Offset="1.0" />
                                            </LinearGradientBrush>
                                        </Grid.Background>

                                        <FontIcon
                                            FontFamily="Segoe Fluent Icons"
                                            Glyph="&#xE786;"
                                            FontSize="36"
                                            Foreground="#5a5a6a"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />

                                        <!-- Top-row chips -->
                                        <Grid Margin="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Visibility="{x:Bind DemoChipVisibility}"
                                                Background="#73000000"
                                                BorderBrush="#fb8c0099"
                                                BorderThickness="0"
                                                CornerRadius="999"
                                                Padding="6,2"
                                                VerticalAlignment="Top">
                                                <TextBlock
                                                    Text="DEMO"
                                                    FontSize="9"
                                                    FontWeight="Bold"
                                                    Foreground="#fb8c00" />
                                            </Border>
                                            <Border
                                                Grid.Column="2"
                                                Background="#73000000"
                                                CornerRadius="999"
                                                Padding="6,2"
                                                VerticalAlignment="Top">
                                                <TextBlock
                                                    Text="{x:Bind Duration}"
                                                    FontSize="9"
                                                    FontWeight="Bold"
                                                    FontFamily="Consolas"
                                                    Foreground="#e8e8f0" />
                                            </Border>
                                        </Grid>
                                    </Grid>

                                    <!-- Meta -->
                                    <StackPanel Grid.Row="1" Padding="14" Spacing="6">
                                        <TextBlock
                                            Text="{x:Bind Title}"
                                            TextWrapping="Wrap"
                                            MaxLines="2"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="#e8e8f0" />
                                        <TextBlock
                                            Text="{x:Bind Subtitle}"
                                            FontSize="10"
                                            FontFamily="Consolas"
                                            Foreground="#7a7a85" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- Empty state, only visible when nothing scanned -->
                <StackPanel
                    x:Name="EmptyState"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10"
                    Padding="40">
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        Glyph="&#xE786;"
                        FontSize="36"
                        Foreground="#5a5a6a"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        Text="No bundles yet"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="#e8e8f0"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        Text="Record a session in the overlay or drop a .rcpdv file in your Videos folder to see it here."
                        FontSize="11"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        MaxWidth="320"
                        Foreground="#8a8a95" />
                </StackPanel>

                <!-- Loading -->
                <ProgressRing
                    x:Name="LoadingRing"
                    Width="32"
                    Height="32"
                    IsActive="False"
                    Foreground="#e53935"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Grid>
        </ScrollViewer>

        <TextBlock
            x:Name="ErrorText"
            Grid.Row="2"
            Text=""
            Foreground="#FF6B6B"
            FontSize="12"
            Margin="0,8,0,0" />
    </Grid>
</Page>
