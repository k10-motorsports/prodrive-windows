<Page
    x:Class="RaceCorProDrive.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ds="using:RaceCorProDrive.DesignSystem"
    Background="{ThemeResource ApplicationBackgroundThemeBrush}">

    <Grid Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <StackPanel
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Spacing="20"
            Width="300">

            <ds:Logomark
                Width="160" Height="66"
                IconTone="White"
                HorizontalAlignment="Center" />

            <TextBlock
                Text="RaceCor Pro Drive"
                FontSize="28"
                FontWeight="Bold"
                Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                TextAlignment="Center" />

            <TextBlock
                Text="Broadcast-grade sim racing analytics"
                FontSize="14"
                Foreground="#A0A0A0"
                TextAlignment="Center"
                TextWrapping="WrapWholeWords" />

            <Button
                x:Name="SignInButton"
                Content="Sign in with Discord"
                HorizontalAlignment="Stretch"
                Height="44"
                FontSize="14"
                FontWeight="SemiBold"
                Click="OnSignIn"
                Background="#E53935"
                Foreground="White" />

            <TextBlock
                x:Name="ErrorMessage"
                Text=""
                Foreground="#FF6B6B"
                TextAlignment="Center"
                TextWrapping="WrapWholeWords"
                FontSize="12" />
        </StackPanel>
    </Grid>
</Page>
