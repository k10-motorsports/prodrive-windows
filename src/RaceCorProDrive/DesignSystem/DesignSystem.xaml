<ResourceDictionary
    x:Class="RaceCorProDrive.DesignSystem.DesignSystem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RaceCorProDrive.DesignSystem">
    <!--
        Full palette — matches the Swift `Palette` enum in
        racecor-prodrive-macos/apps/native/Sources/DesignSystem/BrandKit.swift
        1:1 so every platform reads from the same color values. When a
        brand, badge, or semantic color appears on the web or in the
        mac/iOS builds, look it up here first.

        Alpha-blended colors (text dim / muted / border subtle) use
        explicit #AARRGGBB hex rather than the SwiftUI Color.opacity()
        path so XAML bindings can stay literal.
    -->

    <!-- Background -->
    <Color x:Key="BgBase">#0A0A14</Color>
    <Color x:Key="BgSurface">#E6101020</Color>
    <Color x:Key="BgPanel">#F20A0A14</Color>
    <Color x:Key="BgElevated">#14142A</Color>

    <!-- Brand: RaceCor red -->
    <Color x:Key="BrandRed">#E53935</Color>
    <Color x:Key="BrandMid">#B02020</Color>
    <Color x:Key="BrandDark">#700010</Color>
    <!-- Legacy alias kept so existing XAML that bound to K10Red keeps rendering. -->
    <Color x:Key="K10Red">#E53935</Color>
    <Color x:Key="K10RedDark">#C81E1E</Color>

    <!-- Text -->
    <Color x:Key="TextPrimary">#E8E8F0</Color>
    <Color x:Key="TextSecondary">#B0FFFFFF</Color>
    <Color x:Key="TextDim">#7AFFFFFF</Color>
    <Color x:Key="TextMuted">#52FFFFFF</Color>

    <!-- Borders -->
    <Color x:Key="BorderSubtle">#24FFFFFF</Color>
    <Color x:Key="BorderAccent">#59E53935</Color>

    <!-- Semantic -->
    <Color x:Key="SuccessGreen">#34C759</Color>
    <Color x:Key="WarningYellow">#FF9F0A</Color>
    <Color x:Key="ErrorRed">#FF6B6B</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BrandRedBrush"       Color="{StaticResource BrandRed}" />
    <SolidColorBrush x:Key="BgBaseBrush"         Color="{StaticResource BgBase}" />
    <SolidColorBrush x:Key="BgSurfaceBrush"      Color="{StaticResource BgSurface}" />
    <SolidColorBrush x:Key="BgPanelBrush"        Color="{StaticResource BgPanel}" />
    <SolidColorBrush x:Key="BgElevatedBrush"     Color="{StaticResource BgElevated}" />

    <SolidColorBrush x:Key="TextPrimaryBrush"    Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush"  Color="{StaticResource TextSecondary}" />
    <SolidColorBrush x:Key="TextDimBrush"        Color="{StaticResource TextDim}" />
    <SolidColorBrush x:Key="TextMutedBrush"      Color="{StaticResource TextMuted}" />

    <SolidColorBrush x:Key="BorderSubtleBrush"   Color="{StaticResource BorderSubtle}" />
    <SolidColorBrush x:Key="BorderAccentBrush"   Color="{StaticResource BorderAccent}" />

    <SolidColorBrush x:Key="SuccessBrush"        Color="{StaticResource SuccessGreen}" />
    <SolidColorBrush x:Key="ErrorBrush"          Color="{StaticResource ErrorRed}" />

    <!-- Legacy aliases kept so existing controls compile without change. -->
    <SolidColorBrush x:Key="K10RedBrush"         Color="{StaticResource BrandRed}" />
    <SolidColorBrush x:Key="BackgroundBrush"     Color="{StaticResource BgBase}" />
    <SolidColorBrush x:Key="SurfaceBaseBrush"    Color="{StaticResource BgElevated}" />

    <!--
        Dark themed DropDownButton — matches the dashboard's glass
        aesthetic instead of WinUI's default light gray button. Used
        for the Race / Practice + License filter dropdowns at the
        top of the dashboard. Subtle border, transparent fill, hover
        bumps to a faint white wash.

        Per-state hover/pressed colors live in `Page.Resources` on
        the host page (see DashboardPage.xaml) — `Resources` is not
        a DependencyProperty so it can't be set through a Style
        Setter; scoping the overrides at the page level keeps them
        from leaking onto system buttons elsewhere.
    -->
    <Style x:Key="AppDropDownButtonStyle" TargetType="DropDownButton">
        <Setter Property="Background" Value="#1AFFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="10,5,10,5" />
    </Style>
</ResourceDictionary>
