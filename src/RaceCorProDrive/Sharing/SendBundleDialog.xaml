<ContentDialog
    x:Class="RaceCorProDrive.Sharing.SendBundleDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RaceCorProDrive.Sharing"
    Title="Send to Mac"
    PrimaryButtonText="Send"
    CloseButtonText="Cancel"
    PrimaryButtonClick="OnSendClicked"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False">

    <Grid Width="400">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="BundleNameText"
            Margin="0,0,0,4"
            FontSize="13"
            FontWeight="SemiBold"
            Foreground="#e8e8f0"
            TextWrapping="Wrap" />

        <TextBlock
            Grid.Row="1"
            x:Name="StatusText"
            Margin="0,0,0,12"
            FontSize="11"
            Foreground="#8a8a95" />

        <ListView
            Grid.Row="2"
            x:Name="PeerList"
            SelectionMode="Single"
            SelectionChanged="OnPeerSelectionChanged"
            MinHeight="80"
            MaxHeight="220"
            Background="#0f0f1a"
            BorderBrush="#262638"
            BorderThickness="1"
            CornerRadius="6">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:DiscoveredPeerVm">
                    <StackPanel Spacing="2" Padding="6,4">
                        <TextBlock Text="{x:Bind DisplayName}" FontSize="12" Foreground="#e8e8f0" />
                        <TextBlock Text="{x:Bind Subtitle}" FontSize="10" Foreground="#7a7a85" FontFamily="Consolas" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ProgressBar
            Grid.Row="3"
            x:Name="SendProgress"
            Margin="0,12,0,0"
            Visibility="Collapsed"
            Foreground="#e53935" />

        <TextBlock
            Grid.Row="4"
            x:Name="ErrorText"
            Margin="0,8,0,0"
            FontSize="11"
            Foreground="#FF6B6B"
            TextWrapping="Wrap" />
    </Grid>
</ContentDialog>
